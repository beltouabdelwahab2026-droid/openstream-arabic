{
  "manifestVersion": 1,
  "name": "Arabic & Extra Sources",
  "description": "Additional multi-server movie and TV sources.",
  "website": "https://screenscape.me",
  "extensions": [
    {
      "id": "screenscape",
      "name": "ScreenScape",
      "description": "Multi-server movie and TV source with multilingual audio and subtitles.",
      "version": "1.0.0",
      "versionCode": 1,
      "apiVersion": 1,
      "authors": ["Community"],
      "language": "Multi",
      "tags": ["movies", "series", "multi-server", "subtitles"],
      "status": 3,
      "updatedAt": "2026-10-02",
      "installedByDefault": false,
      "fallback": true,
      "engine": {
        "type": "web-embed",
        "movieUrl": "https://nxsha.screenscape.me/embed?tmdb={tmdbId}&type=movie",
        "tvUrl": "https://nxsha.screenscape.me/embed?tmdb={tmdbId}&type=tv&s={season}&e={episode}",
        "priority": 30
      }
    }
  ]
}
